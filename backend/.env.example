# ============================================================================
# Lynceus backend — copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
# ============================================================================

# --- Database (Supabase Postgres) -------------------------------------------
# Supabase → your project → Connect → "Session pooler".
# Replace [YOUR-PASSWORD] with your database password, URL-encoded.
# See SUPABASE-SETUP.md for where to click.
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional but recommended in production. Path to the Supabase CA certificate
# (Connect dialog → download). Without it the connection is encrypted but the
# server certificate is not verified.
# SUPABASE_CA_CERT=./certs/prod-ca-2021.crt

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_a_64_char_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
